


import numpy as np
import pandas as pd
import seaborn as sns 
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import LabelEncoder , StandardScaler, OneHotEncoder
from sklearn.linear_model import LogisticRegression
from sklearn.naive_bayes import GaussianNB
from sklearn.neighbors import KNeighborsClassifier
from sklearn.impute import SimpleImputer
from sklearn.metrics import accuracy_score, precision_score, confusion_matrix, recall_score, f1_score


data = pd.read_csv("loan_approval_data.csv")


data.head(5)


data.info()


data.isnull().sum() # 50 valuse missing in each feature





numeric = data.select_dtypes(include=["number"]).columns


categorical = data.select_dtypes(include="str").columns


categorical





# Handling Numeric Null Value 
imp_mean = SimpleImputer(strategy="mean")
data[numeric] =  imp_mean.fit_transform(data[numeric])


# Handling Categorical Value
most_frequent = SimpleImputer(strategy="most_frequent")
data[categorical] = most_frequent.fit_transform(data[categorical])


data.info()











